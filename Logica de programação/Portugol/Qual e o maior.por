programa {
  funcao inicio() {
    inteiro num1, num2, num3
    escreva ("Digite o primeiro numero: ")
    leia (num1)
    escreva ("Digite o segundo numero: ")
    leia (num2)
    escreva ("Digite o terceiro numero: ")
    leia(num3)
    se (num1>num2 e num1>num3){
      escreva ("O primeiro numero e o maior numero!")
    }
    senao 
    se (num2>num3){
      escreva ("O segundo numero e o maior numero!")
    }
    senao{
      escreva ("O terceiro numero e o maior e o maior numero!")
    }

    
  }
}
